{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/codex-review-gate-autoenable.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/codex-gsd-executor-override.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/luna-skill-autoload.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/luna-clean-hook.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/disk-audit-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/learning-session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/scripts/heavy-gate.mjs\" hook-post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/codex-review-gate-run.mjs\"",
            "timeout": 960
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/learning-capture.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/codex-code-edit-block.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/scripts/heavy-gate.mjs\" hook-pre",
            "timeout": 660
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CLAUDE_HOME}}/hooks/learning-capture.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "luna-local": {
      "source": {
        "source": "directory",
        "path": "{{CLAUDE_HOME}}/local-plugins"
      }
    },
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      }
    }
  },
  "enabledPlugins": {
    "luna-panel@luna-local": true,
    "codex@openai-codex": true
  }
}
