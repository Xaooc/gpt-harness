+pub(crate) fn select_session_shell(
+    config: &crate::config::Config,
+    user_shell_override: Option<Shell>,
+) -> anyhow::Result<Shell> {
+    if let Some(shell) = user_shell_override {
+        return Ok(shell);
+    }
+    if let Some(default_shell) = config.default_shell {
+        let shell_type = match default_shell {
+            DefaultShell::PowerShell => ShellType::PowerShell,
+            DefaultShell::Cmd => ShellType::Cmd,
+            DefaultShell::Sh => ShellType::Sh,
+            DefaultShell::Bash => ShellType::Bash,
+            DefaultShell::Zsh => ShellType::Zsh,
+        };
+        if let Some(path) = config.default_shell_path.as_ref() {
+            if !path.is_absolute() || !path.is_file() {
+                anyhow::bail!(
+                    "default_shell_path `{}` must be an absolute path to an existing file",
+                    path.display()
+                );
+            }
+            return Ok(Shell {
+                shell_type,
+                shell_path: path.clone(),
+            });
+        }
+        return get_shell(shell_type).ok_or_else(|| {
+            anyhow::anyhow!(
+                "default_shell `{}` executable was not found; set default_shell_path to its absolute path",
+                shell_type.name()
+            )
+        });
+    }
+    Ok(default_user_shell())
+}
