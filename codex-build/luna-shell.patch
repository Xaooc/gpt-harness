+use super::*;
+use crate::config::Config;
+use crate::config::ConfigOverrides;
+use codex_config::config_toml::ConfigToml;
+use codex_features::Feature;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+
+async fn config(codex_home: &std::path::Path) -> Config {
+    let mut config = Config::load_from_base_config_with_overrides(
+        ConfigToml::default(),
+        ConfigOverrides {
+            cwd: Some(codex_home.to_path_buf()),
+            ..Default::default()
+        },
+        AbsolutePathBuf::try_from(codex_home).unwrap(),
+    )
+    .await
+    .unwrap();
+    config.features.disable(Feature::ShellZshFork).unwrap();
+    config
+}
+
+#[tokio::test]
+async fn unset_default_shell_preserves_upstream_selection() {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = config(home.path()).await;
+    assert_eq!(
+        select_session_shell(&config, None).unwrap(),
+        default_user_shell()
+    );
+    config.default_shell_path = Some(home.path().join("unused-missing-shell.exe"));
+    assert_eq!(
+        select_session_shell(&config, None).unwrap(),
+        default_user_shell()
+    );
+}
+
+#[tokio::test]
+async fn configured_shell_uses_exact_path_before_zsh_fork() {
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("sh.exe");
+    std::fs::write(&path, "").unwrap();
+    let mut config = config(home.path()).await;
+    config.default_shell = Some(DefaultShell::Sh);
+    config.default_shell_path = Some(path.clone());
+    config.features.enable(Feature::ShellZshFork).unwrap();
+    config.zsh_path = None;
+    assert_eq!(
+        select_session_shell(&config, None).unwrap(),
+        Shell {
+            shell_type: ShellType::Sh,
+            shell_path: path,
+        }
+    );
+}
+
+#[tokio::test]
+async fn configured_shell_rejects_missing_directory_and_relative_paths() {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = config(home.path()).await;
+    config.default_shell = Some(DefaultShell::Sh);
+    for path in [
+        home.path().join("missing-sh.exe"),
+        home.path().to_path_buf(),
+        PathBuf::from("relative-sh.exe"),
+    ] {
+        config.default_shell_path = Some(path.clone());
+        let error = select_session_shell(&config, None).unwrap_err().to_string();
+        assert!(error.contains("default_shell_path"));
+        assert!(error.contains(&path.display().to_string()));
+    }
+}
+
+#[tokio::test]
+async fn user_shell_override_precedes_configured_shell() {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = config(home.path()).await;
+    config.default_shell = Some(DefaultShell::Sh);
+    config.default_shell_path = Some(home.path().join("missing-sh.exe"));
+    let shell = default_user_shell();
+    assert_eq!(
+        select_session_shell(&config, Some(shell.clone())).unwrap(),
+        shell
+    );
+}
+
+#[tokio::test]
+async fn configured_shell_without_path_uses_discovery_without_fallback() {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = config(home.path()).await;
+    for (configured, shell_type) in [
+        (DefaultShell::Sh, ShellType::Sh),
+        (DefaultShell::Bash, ShellType::Bash),
+        (DefaultShell::Zsh, ShellType::Zsh),
+        (DefaultShell::Cmd, ShellType::Cmd),
+        (DefaultShell::PowerShell, ShellType::PowerShell),
+    ] {
+        config.default_shell = Some(configured);
+        match get_shell(shell_type) {
+            Some(expected) => assert_eq!(select_session_shell(&config, None).unwrap(), expected),
+            None => {
+                let error = select_session_shell(&config, None).unwrap_err().to_string();
+                assert!(error.contains("default_shell"));
+                assert!(error.contains(shell_type.name()));
+                assert!(error.contains("default_shell_path"));
+            }
+        }
+    }
+}
+
+#[test]
+fn sh_argv_keeps_upstream_login_rules() {
+    let shell = Shell {
+        shell_type: ShellType::Sh,
+        shell_path: PathBuf::from("sh.exe"),
+    };
+    assert_eq!(
+        shell.derive_exec_args("echo hello", false),
+        vec!["sh.exe", "-c", "echo hello"]
+    );
+    assert_eq!(
+        shell.derive_exec_args("echo hello", true),
+        vec!["sh.exe", "-lc", "echo hello"]
+    );
+}
