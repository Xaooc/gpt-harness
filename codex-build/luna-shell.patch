+#[tokio::test]
+async fn default_shell_loads_from_toml_and_cli_overrides() -> anyhow::Result<()> {
+    use codex_config::config_toml::DefaultShell;
+
+    let codex_home = TempDir::new()?;
+    let path = codex_home.path().join("sh.exe");
+    let override_path = codex_home.path().join("override-sh.exe");
+    std::fs::write(&path, "")?;
+    std::fs::write(&override_path, "")?;
+    std::fs::write(
+        codex_home.path().join(CONFIG_TOML_FILE),
+        format!(
+            "default_shell = \"cmd\"\ndefault_shell_path = {}\n",
+            toml::Value::String(path.to_string_lossy().into_owned())
+        ),
+    )?;
+    for override_shell in [None, Some("sH")] {
+        let config = ConfigBuilder::without_managed_config_for_tests()
+            .codex_home(codex_home.path().to_path_buf())
+            .fallback_cwd(Some(codex_home.path().to_path_buf()))
+            .cli_overrides(
+                override_shell
+                    .map(|value| {
+                        vec![
+                            (
+                                "default_shell".to_string(),
+                                toml::Value::String(value.to_string()),
+                            ),
+                            (
+                                "default_shell_path".to_string(),
+                                toml::Value::String(override_path.to_string_lossy().into_owned()),
+                            ),
+                        ]
+                    })
+                    .unwrap_or_default(),
+            )
+            .build()
+            .await?;
+        assert_eq!(
+            config.default_shell,
+            Some(if override_shell.is_some() {
+                DefaultShell::Sh
+            } else {
+                DefaultShell::Cmd
+            })
+        );
+        assert_eq!(
+            config.default_shell_path.as_ref(),
+            Some(if override_shell.is_some() {
+                &override_path
+            } else {
+                &path
+            })
+        );
+    }
+    Ok(())
+}
