  {
    "id": "luna-local",
    "kind": "marketplace",
    "platforms": [
      "linux",
      "win32"
    ],
    "argv": [
      "claude",
      "plugin",
      "marketplace",
      "add",
      "{{CLAUDE_HOME}}/local-plugins"
    ],
    "probe": [
      {
        "path": ".claude/plugins/known_marketplaces.json",
        "keys": [
          "luna-local"
        ]
      }
    ],
    "purpose": "Register the harness's vendored plugin marketplace with Claude Code.",
    "required": true
  },
  {
    "id": "luna-panel@luna-local",
