    ],
    "probe": [
      {
        "path": ".claude/plugins/installed_plugins.json",
        "keys": [
          "plugins",
          "luna-panel@luna-local"
        ]
      }
    ],
    "purpose": "Install the harness's Luna panel.",
    "required": true
  },
